␀␀␀␀␀␀␀␀␀␀␀␀␀ÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿ␀␀␀ü<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href="/favicon.ico">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WebSocket Terminal</title>
  <style>␀␀ü
    body {
      background: black;
      color: #00ff00;
      font-family: monospace;
      margin: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }
    #controls {
      display: flex;
      gap: 0.5rem;␀␀ü
      padding: 0.5rem;
      background: #111;
      border-bottom: 1px solid #00ff00;
    }
    #controls input, #controls button {
      font-family: monospace;
      font-size: 1rem;
      padding: 0.3rem;
    }
    #url {
      flex: 1␀␀ü;
      background: black;
      color: #00ff00;
      border: 1px solid #00ff00;
    }
    #output {
      flex-grow: 1;
      overflow-y: auto;
      padding: 1rem;
      white-space: pre-wrap;
    }
    #input-container {
      border-t␀␀üop: 1px solid #00ff00;
      padding: 0.5rem 1rem;
    }
    #input {
      width: 100%;
      background: black;
      color: #00ff00;
      border: none;
      outline: none;
      font-family: monospace;
      font-size: 1rem;
    }
   ␀␀ü button {
      background: #000;
      color: #00ff00;
      border: 1px solid #00ff00;
      cursor: pointer;
    }
    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  </style>
</head>
<body>

  <div id="contro␀␀üls">
    <input type="text" id="url" placeholder="ws://localhost:8080" />
    <button id="connect">Connect</button>
    <button id="disconnect" disabled>Disconnect</button>
  </div>

  <div id="output"></div>
  <div id="input-container">
    <␀␀üinput id="input" autocomplete="off" autofocus placeholder="Type a command and press Enter..." />
  </div>

  <script>
    let ws = null;
    let buffer = [];
    const MAX_LINES = 500; // scrollback limit    

    const urlInput = document.get␀␀üElementById('url');
    const connectBtn = document.getElementById('connect');
    const disconnectBtn = document.getElementById('disconnect');

    const output = document.getElementById("output");
    const input = document.getElementById("inpu␀	␀üt");


    function printLine(text, prefix = "") 
    {
      buffer.push(prefix + text);
      if (buffer.length > MAX_LINES) buffer.shift(); // keep only last N lines
      output.textContent = buffer.join("");
      output.scrollTop = outpu␀␀␀␀␀␀␀ÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿÿ*ÿÿ␀
␀üt.scrollHeight;   
    }

    fetch("/data.json")
      .then(res=>res.json())
      .then(data=>
        {
          urlInput.value = `ws://${data.ws_uri}:8765`;
        })
      .catch(err => printLine('Could not load IP address.', '[system␀␀ü]'));;

    connectBtn.addEventListener('click', () => {
      const url = urlInput.value.trim();
      if (!url) return alert('Enter WebSocket URL');
      try {
        ws = new WebSocket(url);
      } catch (err) {
        return printLine(␀␀ü'Invalid URL', 'system');
      }

      ws.onopen = () => {
        printLine("Connected to WebSocket.", "[system event]");
        input.disabled = false;
        connectBtn.disabled = true;
        disconnectBtn.disabled = false;
      };
␀␀ü
      ws.onclose = () => {
        printLine("WebSocket disconnected.", "[system event]");
        input.disabled = true;
        connectBtn.disabled = false;
        disconnectBtn.disabled = true;
      };

      ws.onmessage = (e) => printL␀␀üine(e.data);
      ws.onerror = (e) => printLine(`WebSocket error: ${e}`, "system");
    });

    disconnectBtn.addEventListener('click', () => {
      if (ws) ws.close();
    });
   
    input.addEventListener("keydown", (e) => 
    {
     ␀␀ü   if (e.key === "Enter") 
        {
            const msg = input.value;
            if (msg) 
            {
                ws.send(msg);
                input.value = "";
            }
            else
            {
                ws.sen␀␀üd("\n");
            }
        }
    });
  </script>
